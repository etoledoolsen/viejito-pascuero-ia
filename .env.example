# Solo en el servidor; nunca introducir en la app móvil ni publicar este archivo
OPENAI_API_KEY=
# Al publicar: obligatorio, al menos 10 caracteres, usa una contraseña única
FAMILY_PASSWORD=
# Modelo de Realtime disponible en tu cuenta
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
PORT=8765
# localhost para pruebas en computador; 0.0.0.0 en hosting HTTPS
HOST=127.0.0.1
